# Keycloak (service « identite » du stack) — gabarit. Copier en .env et remplir.
# Compose : oria-stack/infra/keycloak/docker-compose.yml charge automatiquement ce .env
# pour l'interpolation ${...}. Importe forge-realm.json + oria-realm.json au 1er lancement
# (command: start-dev --import-realm).
#
# ⚠️ SECRETS — ne JAMAIS committer le .env réel (il est gitignoré). En prod, mettre des
# valeurs fortes et uniques.

# Compte admin de la console Keycloak (http://<host>:${KEYCLOAK_HOST_PORT}/admin).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-admin

# Mot de passe Postgres interne de Keycloak.
KEYCLOAK_DB_PASSWORD=change-me-db

# Port hôte exposant Keycloak (interne au stack : http://identite:8080).
KEYCLOAK_HOST_PORT=8080
