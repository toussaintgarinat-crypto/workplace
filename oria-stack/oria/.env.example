# Usage standalone uniquement (docker compose -f oria/docker-compose.yml).
# Via Makefile racine : cp .env.example .env && make seed-envs && make start-oria
# Note : les variables sont traduites depuis ORIA_POSTGRES_USER → POSTGRES_USER, etc.

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://oria:oria_secret@db:5432/oria
POSTGRES_DB=oria
POSTGRES_USER=oria
POSTGRES_PASSWORD=change_this_in_production

# ── PostgreSQL HA (Patroni) ─────────────────────────────────
# Secrets internes du cluster Patroni. Défauts `_change_me` dans le compose :
# À REMPLACER en prod (sinon superuser/réplication ont un mot de passe public).
POSTGRES_SUPERUSER_PASSWORD=change_this_in_production
REPLICATOR_PASSWORD=change_this_in_production
REWIND_PASSWORD=change_this_in_production

# ── MinIO (stockage objet S3) ───────────────────────────────
MINIO_ROOT_USER=oria
MINIO_ROOT_PASSWORD=change_this_in_production

# ── Keycloak — allow-lists multi-bundles (S14) ──────────────
# Realms d'apps livrées acceptés (motif suffixe *). Anti-SSRF sur les JWKS.
KEYCLOAK_REALMS_AUTORISES=client-*
KEYCLOAK_ISSUERS_AUTORISES=

# ── Keycloak Auth ────────────────────────────────────────────
KEYCLOAK_URL=http://keycloak:8080         # URL interne Docker; https://auth.votredomaine.com en prod
KEYCLOAK_REALM=oria
KEYCLOAK_CLIENT_ID=oria-app
# Keycloak audience (multi-tenant) — utilisé comme audience JWT. Vide = non applicable.
KEYCLOAK_AUDIENCE=oria-app
# Identifiants admin Keycloak (interface /admin)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_this_in_production
# Frontend (exposed au navigateur — URL publique)
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=oria
VITE_KEYCLOAK_CLIENT_ID=oria-app

# ── CORS ────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── LiveKit ─────────────────────────────────────────────────
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
# OBLIGATOIRE — openssl rand -base64 32
LIVEKIT_API_SECRET=

# ── Matrix / Dendrite ────────────────────────────────────────
MATRIX_HOMESERVER_URL=http://dendrite:8008
MATRIX_SERVER_NAME=oria.local
# OBLIGATOIRE — openssl rand -hex 32
MATRIX_AS_TOKEN=
# OBLIGATOIRE — openssl rand -hex 32
MATRIX_HS_TOKEN=
# OBLIGATOIRE en prod — openssl rand -hex 32 (utilisé par init-dendrite.sh)
MATRIX_REGISTRATION_SHARED_SECRET=
# Mettre à false pour ouvrir l'inscription publique Matrix (Sprint 71)
MATRIX_REGISTRATION_DISABLED=true

# ── Forge (IA agent — optionnel) ────────────────────────────
# URL du backend Forge. Sans Forge, Oria fonctionne seul (texte/voix uniquement).
FORGE_URL=http://localhost:3001
# Token d'auth agents résidents — laisser vide si Forge non utilisé
FORGE_TOKEN=
DEFAULT_AGENT_PROVIDER=openrouter
DEFAULT_AGENT_MODEL=anthropic/claude-sonnet-4-6

# ── Mémoire (brique Workplace, port 5600 — optionnel) ───────
# Oria délègue toute sa mémoire (IPCRa, documents, conversations) à la brique
# Mémoire Workplace via son contrat simple retenir/rappeler. Vide → mémoire
# désactivée (dégradation gracieuse). Remplace l'ancien MemPalace (palace 8100 +
# Qdrant local), décommissionné.
# En stack Docker, joindre la brique de l'hôte via host.docker.internal :
MEMOIRE_URL=http://host.docker.internal:5600

# ── Chiffrement clés LLM en DB ──────────────────────────────
# Chiffre les clés API LLM stockées dans llm_configs. Si absent, stockage en clair.
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_ENCRYPTION_KEY=

# ── Ollama Bridge (LLM local — optionnel) ───────────────────
# Permet aux agents Forge configurés avec ollama de joindre le LLM local.
# Lance infra/ollama-bridge/ puis renseigne l'URL dans les agents Oria.
# (URL Bridge : http://<IP-MAC>:11436)

# ── Calendar service (S2S) ───────────────────────────────────
CALENDAR_URL=http://calendar:8400
CALENDAR_SERVICE_TOKEN=

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
# Indexation documents → jobs durables (Redis Streams, S125)
ORIA_DOCPARSE_WORKERS=2        # concurrence GLOBALE d'indexation (tous réplicas)
ORIA_DOCPARSE_MAX_RETRIES=3    # tentatives avant dead-letter queue

# ── Stripe (optionnel) ───────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ── Frontend ────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_LIVEKIT_URL=ws://localhost:7880
VITE_MATRIX_URL=http://localhost:8008
FRONTEND_URL=http://localhost:3000
