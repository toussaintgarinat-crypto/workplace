# Configuration Workplace ↔ Unmute. Copie ce fichier en `.env` et adapte.

# --- LLM : la Gateway LiteLLM de Workplace (port 4001) ---
# Même machine que Workplace (GPU local Linux) :
KYUTAI_LLM_URL=http://host.docker.internal:4001/v1
# GPU distant (cloud, autre PC) : mets l'IP/host de la machine Workplace :
# KYUTAI_LLM_URL=http://192.168.1.50:4001/v1

# Clé maître de la Gateway (cf. briques/gateway/.env : LITELLM_MASTER_KEY).
KYUTAI_LLM_API_KEY=sk-master-change-this

# Modèle à utiliser (doit exister dans briques/gateway/litellm_config.yaml).
KYUTAI_LLM_MODEL=openai/gpt-4o-mini

# Token Hugging Face (téléchargement des poids STT/TTS Kyutai au 1er lancement).
HUGGING_FACE_HUB_TOKEN=hf_xxx
