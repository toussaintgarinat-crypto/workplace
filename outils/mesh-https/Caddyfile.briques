# Forge (SPA + Keycloak same-origin) — 3000 → 13000 (S130)
# nginx interne proxifie /realms/* et /resources/* vers Keycloak (:8081).
https://workplaceagenda.duckdns.org:13000 {
	import brique_mesh 3000
}
