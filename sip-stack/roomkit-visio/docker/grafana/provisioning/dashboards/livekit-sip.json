{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Active Calls",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(livekit_sip_calls_active)", "legendFormat": "Active" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 10 }] } } },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },
    {
      "title": "CPU Load",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "livekit_node_cpu_load", "legendFormat": "CPU" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "unit": "percentunit", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "red", "value": 0.9 }] } } },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },
    {
      "title": "Node Available",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "livekit_sip_available", "legendFormat": "Available" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "NO", "color": "red" }, "1": { "text": "YES", "color": "green" } } }] } },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },
    {
      "title": "Active Transfers",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "sum(livekit_sip_transfers_active)", "legendFormat": "Transfers" }],
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },
    {
      "title": "INVITE Requests (rate/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "rate(livekit_sip_invite_requests_raw[5m]) * 60", "legendFormat": "Raw INVITEs" },
        { "expr": "sum by (dir) (rate(livekit_sip_invite_requests[5m])) * 60", "legendFormat": "Valid ({{dir}})" },
        { "expr": "sum by (dir) (rate(livekit_sip_invite_accepted[5m])) * 60", "legendFormat": "Accepted ({{dir}})" }
      ],
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },
    {
      "title": "INVITE Errors (rate/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "sum by (reason) (rate(livekit_sip_invite_error[5m])) * 60", "legendFormat": "{{reason}}" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } } },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },
    {
      "title": "Calls Active Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "sum by (dir) (livekit_sip_calls_active)", "legendFormat": "{{dir}}" }
      ],
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },
    {
      "title": "Calls Terminated (rate/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "sum by (reason) (rate(livekit_sip_calls_terminated[5m])) * 60", "legendFormat": "{{reason}}" }
      ],
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },
    {
      "title": "RTP Packets (rate/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        { "expr": "sum by (op) (rate(livekit_sip_packets_rtp[5m]))", "legendFormat": "{{op}}" }
      ],
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },
    {
      "title": "RTP Packets by Payload Type (rate/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        { "expr": "sum by (payload, op) (rate(livekit_sip_packets_rtp[5m]))", "legendFormat": "{{op}} {{payload}}" }
      ],
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },
    {
      "title": "Session Duration (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 28 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(livekit_sip_dur_session_sec_bucket[15m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(livekit_sip_dur_session_sec_bucket[15m])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(livekit_sip_dur_session_sec_bucket[15m])) by (le))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },
    {
      "title": "Join Duration (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 28 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(livekit_sip_dur_join_sec_bucket[15m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(livekit_sip_dur_join_sec_bucket[15m])) by (le))", "legendFormat": "p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },
    {
      "title": "Transfers (rate/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 28 },
      "targets": [
        { "expr": "sum(rate(livekit_sip_transfers_total[5m])) * 60", "legendFormat": "Total" },
        { "expr": "sum(rate(livekit_sip_transfers_succeeded_total[5m])) * 60", "legendFormat": "Succeeded" },
        { "expr": "sum(rate(livekit_sip_transfers_failed_total[5m])) * 60", "legendFormat": "Failed" }
      ],
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },
    {
      "title": "SDP Size Distribution",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, type) (rate(livekit_sip_sdp_size_bytes_bucket[15m])))", "legendFormat": "p50 {{type}}" },
        { "expr": "histogram_quantile(0.95, sum by (le, type) (rate(livekit_sip_sdp_size_bytes_bucket[15m])))", "legendFormat": "p95 {{type}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },
    {
      "title": "LiveKit-SIP Logs",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 44 },
      "targets": [{ "expr": "{container=~\".*livekit-sip.*\"}", "refId": "A" }],
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" }
    }
  ],
  "schemaVersion": 39,
  "templating": {
    "list": [
      { "name": "DS_PROMETHEUS", "type": "datasource", "query": "prometheus", "current": { "text": "Prometheus", "value": "Prometheus" } },
      { "name": "DS_LOKI", "type": "datasource", "query": "loki", "current": { "text": "Loki", "value": "Loki" } }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "LiveKit-SIP",
  "uid": "livekit-sip"
}
