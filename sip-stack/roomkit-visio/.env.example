# Host LAN IP. `make env` overwrites this with the auto-detected value.
MY_IP_ADDR=192.168.0.10

# Path to the livekit-sip checkout used by `make sip-build`.
# LIVEKIT_SIP_SRC=../livekit-sip

# Used by compose.override.yml (S197 Workplace override) — same values as
# STANDARD_TEL_LIVEKIT_API_KEY / _SECRET in the monorepo root .env.
LIVEKIT_API_KEY=changeme
LIVEKIT_API_SECRET=changeme
