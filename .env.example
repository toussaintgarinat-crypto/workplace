# ============================================================================
#  SECRETS PARTAGÉS WORKPLACE — modèle. Copier en .env et remplacer les valeurs.
#    cp .env.example .env
#  Générer une clé/secret : openssl rand -hex 32
# ============================================================================

# ── CORS — origines navigateur autorisées (noyau + briques autonomes) ─────────
# Liste CSV des origines autorisées à appeler les API depuis un NAVIGATEUR.
# Défaut "*" = comportement historique (dev mono-tenant local). En MULTI-TENANT,
# même sur la même machine (autre tenant ou autre assistant sur localhost),
# RESTREINDRE pour qu'une page web tierce ne puisse pas piloter les briques :
#   CORS_ORIGINS=http://localhost:5100,http://localhost:3003,http://localhost:6060
# Rappel : le CORS ne protège que le navigateur. Le contrôle serveur-à-serveur
# se fait par API_KEYS / X-API-Key sur chaque brique (voir plus bas).
CORS_ORIGINS=*

# Clés d'API acceptées par les briques autonomes (calcul, images, personnages,
# studio, transcription, video, vision, connexion) — CSV, en-tête X-API-Key.
# VIDE = mode OUVERT (n'importe quel process local peut appeler la brique : OK en
# dev mono-tenant). En MULTI-TENANT, même sur la même machine (autre assistant /
# tenant sur localhost), DÉFINIR une ou plusieurs clés pour fermer l'accès :
#   API_KEYS=$(openssl rand -hex 32)
# (Le « compte Studio » garde sa variable dédiée STUDIO_KEY, voir plus bas.)
API_KEYS=

# ── Pont messageries (brique connexion, 5870) ─────────────────────────────────
# L'assistant répond sur Telegram/WhatsApp/Discord UNIQUEMENT si le jeton du réseau
# est posé ICI (le .env racine, hérité par la brique via env_file). Sans jeton, le
# réseau reste inerte (`/sonder/telegram` renvoie "configure": false).
#   Telegram : créer un bot via @BotFather (/newbot) → coller le token ci-dessous.
TELEGRAM_BOT_TOKEN=
# Secret du webhook Telegram (si tu utilises le mode webhook plutôt que le polling).
TELEGRAM_WEBHOOK_SECRET=
# WhatsApp Cloud API (Meta) — token + identifiant du numéro + vérif webhook + secret app.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Discord — clé publique (vérif des interactions) + token du bot.
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# Sécurité du pont : 0 = un inconnu ne passe PAS tant qu'il n'est pas relié à un
# utilisateur (recommandé). Mettre 1 pour ouvrir en dev. Identifiant attribué par
# défaut quand ouvert. Ordre/filtre des réseaux actifs (CSV) ; vide = tous.
CONNEXION_OUVERT=0
CONNEXION_UTILISATEUR_DEFAUT=
CONNEXION_RESEAUX=

# Pas de balayage de l'horloge du noyau (secondes). Défaut code = 900 (15 min).
# C'est ce tick qui plafonne la réactivité de TOUTES les tâches périodiques, dont
# `poll-telegram` : pour que l'assistant réponde quasi en temps réel sur Telegram,
# baisser ici (ex. 3 = 3 s) ET la `cadence_heures` de la tâche dans le manifest de
# la brique connexion. Un getUpdates Telegram toutes les 3 s reste léger.
# ⚠ Pris en compte au DÉMARRAGE du noyau : `docker compose up -d core` (pas restart).
HORLOGE_INTERVALLE=900

# Clé maîtresse du Gateway LiteLLM (mêmes 4 valeurs identiques — voir .env).
# GATEWAY_API_KEY est l'alias lu par la brique Forge (app/config.py) ; sans elle
# Forge retombe sur son défaut « sk-forge » que le Gateway rejette (auth KO).
LITELLM_MASTER_KEY=sk-wp-CHANGE-ME
GATEWAY_KEY=sk-wp-CHANGE-ME
LLM_API_KEY=sk-wp-CHANGE-ME
GATEWAY_API_KEY=sk-wp-CHANGE-ME

# Secret de signature JWT de la brique mémoire.
JWT_SECRET=CHANGE-ME

# ── Durcissement (optionnel) ──────────────────────────────────────────────────
# Ces variables ont toutes un défaut « historique » dans les docker-compose
# (ex. mot de passe `litellm`/`memory`/`forge`). Les laisser vides = on garde ce
# défaut. Pour durcir : décommenter, mettre une valeur forte (openssl rand -hex 32)
# ET recréer le volume concerné — un changement de mot de passe ne s'applique pas
# à un volume Postgres déjà initialisé. Cf. commentaires des compose respectifs.
# Mots de passe des bases dédiées :
#GATEWAY_DB_PASSWORD=
#MEMOIRE_DB_PASSWORD=
#FORGE_DB_PASSWORD=
# Clé de chiffrement at-rest des secrets Forge (32 caractères) :
#FORGE_ENCRYPTION_KEY=
# Secret du client de service forge-service (auth S2S de l'adaptateur Forge) :
#FORGE_SERVICE_SECRET=
# Jeton de service S2S vers la brique Agenda (requis si AGENDA_AUTH_ENABLED=true) :
#CALENDAR_SERVICE_TOKEN=

# Audience attendue par Forge (S18-2). Vide ⇒ verify_aud désactivé (posture S17,
# tout JWT du realm `oria` accepté). Mettre `forge` SEULEMENT après ré-import de
# oria-realm.json (mapper `audience-forge` qui ajoute `aud: forge` aux tokens
# forge-service + oria-app), sinon l'auth Forge casse. Rollback : remettre à vide.
FORGE_KEYCLOAK_AUDIENCE=

# ── Versions des images Forge buildées localement ─────────────────────────────
# Tags versionnés (et non `:latest`) des images construites sur place. Un `up -d`
# ne reconstruit pas une image déjà présente : avec `:latest` on servait parfois
# une image périmée (bug « process stale »). En BUMPANT ces numéros, `up -d` doit
# reconstruire (l'image taguée n'existe pas encore). Même convention que les
# briques workplace/* (ex. workplace/studio:0.4.0).
FORGE_CORE_VERSION=0.1.0
FORGE_FRONTEND_VERSION=0.1.0

# ── Frontend Forge intégré (S19) ──────────────────────────────────────────────
# Port hôte où la SPA Forge est servie (service `frontend` de la brique forge).
# Doit faire partie des redirectUris/webOrigins du client `oria-app` du realm oria
# (3000 y est déjà autorisé). L'onglet « Forge » du dashboard pointe son iframe ici.
FORGE_FRONTEND_PORT=3000
# URL de la SPA Forge vue par le NAVIGATEUR — reprise par le Cœur (iframe onglet Forge).
FORGE_UI_URL=http://localhost:3000
# URLs des briques créatives vues par le NAVIGATEUR — reprises par le Cœur (onglet « Créations »).
# Studio audio-séries (brique 6060, migré d'Oria vers le Cœur) + atelier Personnages (5900).
STUDIO_UI_URL=http://localhost:6060/atelier
PERSONNAGES_UI_URL=http://localhost:5900/atelier
# « Compte Studio » = clé de service partagée entre le noyau (assistant + iframe) et la brique
# Studio (auth X-API-Key). Variable DÉDIÉE (pas le générique API_KEYS, lu par d'autres briques).
# Vide = brique en mode ouvert. Génère une clé URL-safe : `openssl rand -hex 32`.
STUDIO_KEY=
# Brique « restaurant » (commande & paiement à table par QR, multi-tenant, port 6010).
# Embarquée dans l'onglet « Atelier » du dashboard.
RESTAURANT_UI_URL=http://localhost:6010/
# Secret de signature des sessions restaurateurs (HMAC). À DÉFINIR pour exposer la brique
# (défaut DEV non secret sinon). Génère une clé : `openssl rand -hex 32`.
RESTAURANT_SECRET=
# URL publique vue par le smartphone du client (contenu des QR codes des tables). À définir
# une fois la brique exposée (tunnel/Proxmox) ; vide = déduite de la requête (≠ joignable
# depuis un téléphone en localhost, ce qui est attendu en dev).
RESTAURANT_PUBLIC_URL=
# Réglages SSO injectés au BUILD de la SPA (valeurs vues par le navigateur).
# Défauts = realm `oria`, Keycloak sur le port hôte 8081, client public `oria-app`.
# Laisser VITE_API_URL vide ⇒ appels same-origin proxy-fiés par nginx vers le core.
FORGE_FRONTEND_API_URL=
FORGE_FRONTEND_KEYCLOAK_URL=http://localhost:8081
FORGE_FRONTEND_KEYCLOAK_REALM=oria
FORGE_FRONTEND_KEYCLOAK_CLIENT_ID=oria-app

# ── Brique images (moteur d'illustration, port 5950) ─────────────────────────
# PROVIDER-AGNOSTIQUE : plusieurs moteurs essayés dans un ORDRE de préférence ; le 1er
# qui rend une image gagne, sinon placeholder honnête (jamais de fausse image). L'ordre
# se règle par IMAGE_PROVIDERS (liste). Défaut : comfyui (souverain) → gateway → hébergés.
#   IMAGE_PROVIDERS=gateway          # forcer la Gateway uniquement
IMAGE_PROVIDERS=

# gateway — passe par la GATEWAY Workplace (LiteLLM → OpenRouter), comme l'assistant pour
# le texte. AUCUNE clé d'image à poser ici : la clé OpenRouter vit déjà côté Gateway, et
# GATEWAY_KEY/GATEWAY_URL sont déjà définis plus haut. Marche « out of the box ».
# Modèle d'image OpenRouter (défaut = Nano Banana) :
# IMAGE_GATEWAY_MODEL=google/gemini-2.5-flash-image

# comfyui — moteur SOUVERAIN auto-hébergé (gratuit). COMFY_URL accepte une LISTE d'URLs
# (séparées par virgule), essayées dans l'ordre : la 1re joignable sert. On garde ainsi
# distant (GPU rapide) ET local (ce Mac, CPU) ouverts en même temps.
#   COMFY_URL=http://mon-gpu.exemple:8188,http://host.docker.internal:8188
COMFY_URL=
COMFY_CKPT=sd_xl_base_1.0.safetensors

# nanobanana — Google « Nano Banana » (Gemini image) : rapide, bon rendu de texte.
GEMINI_API_KEY=
# NANOBANANA_MODEL=gemini-2.5-flash-image

# fal — fal.ai : gros catalogue (FLUX & co.), facturation à la sortie.
FAL_KEY=
# FAL_MODEL=fal-ai/flux/schnell

# replicate — très large catalogue + fine-tunes communautaires.
REPLICATE_API_TOKEN=
# REPLICATE_MODEL=black-forest-labs/flux-schnell

# openai — gpt-image-1.
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1

# pruna — Pruna AI « P-Image » (sub-seconde). Endpoint paramétrable (API récente).
PRUNA_API_KEY=
# PRUNA_API_URL=https://api.pruna.ai/v1/inference
# PRUNA_MODEL=p-image

# ── Brique video (génération vidéo, port 5970) ───────────────────────────────
# PROVIDER-AGNOSTIQUE comme la brique images : moteurs vidéo essayés dans un ORDRE ; le
# 1er qui rend une vidéo gagne, sinon placeholder honnête (jamais de fausse vidéo). Pas de
# moteur souverain local (le Mac n'a pas de GPU). L'ordre se règle par VIDEO_PROVIDERS.
# Défaut : fal → replicate → luma → runway → gateway.
#   VIDEO_PROVIDERS=gateway          # forcer la Gateway uniquement
VIDEO_PROVIDERS=

# gateway — passe par la GATEWAY Workplace (réutilise GATEWAY_KEY/GATEWAY_URL ci-dessus).
# Expérimental côté vidéo : ne rend une vidéo que si le modèle OpenRouter choisi en produit.
# VIDEO_GATEWAY_MODEL=google/veo-3-fast

# fal — fal.ai : gros catalogue vidéo (Kling, Wan, LTX, Veo…). Réutilise FAL_KEY (défini
# plus haut pour les images), seul le modèle vidéo diffère :
# FAL_VIDEO_MODEL=fal-ai/ltx-video

# replicate — catalogue vidéo, Prefer: wait synchrone (polling en repli). Réutilise
# REPLICATE_API_TOKEN (ci-dessus), seul le modèle vidéo diffère :
# REPLICATE_VIDEO_MODEL=wan-video/wan-2.2-t2v-fast

# luma — Luma « Dream Machine » (Ray) : jobs + polling.
LUMAAI_API_KEY=
# LUMA_VIDEO_MODEL=ray-2

# runway — Runway « Gen » : tâches + polling. En-tête de version requis.
RUNWAY_API_KEY=
# RUNWAY_VIDEO_MODEL=gen4_turbo
# RUNWAY_API_VERSION=2024-11-06

# ── Muscle déporté / partage de puissance de calcul (brique calcul + mesh NetBird) ──
# Le « Muscle » = une ou PLUSIEURS machines (Mac/PC) qui calculent le LLM, jointes par le
# mesh NetBird (aucun port ouvert sur la box). Cf. GUIDE-mesh-netbird.md.
#
# 1) Le Cœur consulte la brique calcul pour mettre un nœud PRÊT en tête de cascade.
MUSCLE_ACTIF=0                                   # 1 = activer (aussi réglable dans ⚙ Cerveau)
CALCUL_URL=http://host.docker.internal:5990      # URL de la brique calcul (override)
#
# 2) Parc des nœuds, lu par la brique calcul (JSON, une entrée par machine). `endpoint` =
#    adresse MESH OpenAI-compatible ; `modele_gateway` = l'entrée Gateway correspondante
#    (local/muscle-1, local/muscle-2, ou ollama/llama3.3). `priorite` : plus petit = préféré.
# CALCUL_NOEUDS=[{"id":"mac-studio","nom":"Mac Studio","endpoint":"http://100.100.0.1:11434","mac_wol":"AA:BB:CC:DD:EE:01","methode_reveil":["wol","wakeping"],"priorite":10,"modele_gateway":"ollama/llama3.3"},{"id":"mac-mini","nom":"Mac mini","endpoint":"http://100.100.0.2:1234/v1","methode_reveil":["wakeping"],"priorite":20,"modele_gateway":"local/muscle-2"}]
#
# 3) Adresses MESH vues par la Gateway (pour les entrées local/muscle-n du config LiteLLM).
#    Doivent matcher les `endpoint` ci-dessus. Vide = entrée inerte.
# MUSCLE_1_URL=http://100.100.0.1:11434/v1
# MUSCLE_2_URL=http://100.100.0.2:1234/v1
#    Cas mono-muscle Ollama : il suffit de pointer OLLAMA_URL sur l'IP mesh du Mac.
# OLLAMA_URL=http://100.100.0.1:11434
#
# 4) Repli SOUVERAIN CPU sur le Cœur (S62) : petit modèle local tournant sur la machine
#    du Cœur, dernier maillon de la cascade quand le Muscle dort ET que les gratuits
#    échouent → on reste 100 % local (lent) plutôt que de tomber sur le payant cloud.
#    `LOCAL_CPU_URL` = serveur OpenAI-compatible local (llama.cpp/Ollama léger).
# LOCAL_CPU_URL=http://host.docker.internal:8080/v1
# REPLI_SOUVERAIN=local/cpu                       # nom Gateway du repli (vide = désactivé)
# REPLI_SOUVERAIN_AVANT_PAYANT=1                   # 1 = souveraineté d'abord (avant le payant cloud)
