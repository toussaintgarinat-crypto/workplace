{
  "nom": "etl",
  "famille": "ingestion",
  "version": "0.1.0",
  "description": "Ingestion de documents — extraction de texte (PDF, Word, images, Excel, HTML…) et stockage pour l'Audit",
  "role": "etl",
  "couche": "backend",
  "statut": "actif",
  "chemin_source": "~/Desktop/Workplace/briques/etl",
  "port": 5200,
  "url_sante": "http://host.docker.internal:5200/sante",
  "depends_on": [],
  "offre": [
    "ingestion_fichier",
    "ingestion_url",
    "liste_documents",
    "lecture_document"
  ],
  "besoin": [],
  "capacites": [
    {
      "nom": "etl_ingerer_url",
      "description": "Ingère un document depuis une URL distante (PDF en ligne, page web, article). Le texte est extrait et indexé. Utilise cette capacité quand l'utilisateur donne un lien vers un document à ajouter.",
      "methode": "POST",
      "chemin": "/ingerer/url",
      "params": {
        "url": {
          "type": "string",
          "description": "URL du document à ingérer (PDF, HTML…).",
          "requis": true
        }
      },
      "action": true
    },
    {
      "nom": "etl_documents_lister",
      "description": "Liste les documents ingérés (texte extrait disponible). Filtrable par catégorie, projet ou entreprise. Utilise avant de lire ou classer un document.",
      "methode": "GET",
      "chemin": "/documents",
      "params": {
        "categorie": {
          "type": "string",
          "description": "Filtrer par catégorie de classement (optionnel)."
        },
        "projet": {
          "type": "string",
          "description": "Filtrer par projet (optionnel)."
        },
        "entreprise_id": {
          "type": "string",
          "description": "Filtrer par entreprise rattachée (optionnel)."
        },
        "limite": {
          "type": "integer",
          "description": "Nombre maximum de documents renvoyés (défaut : 50)."
        },
        "offset": {
          "type": "integer",
          "description": "Décalage pour paginer (défaut : 0)."
        }
      },
      "action": false
    },
    {
      "nom": "etl_supprimer_document",
      "description": "Supprime définitivement un document ingéré (par son id obtenu via etl_documents_lister). ACTION irréversible.",
      "methode": "DELETE",
      "chemin": "/documents/{doc_id}",
      "params": {
        "doc_id": {
          "type": "string",
          "description": "Identifiant du document (obtenu via etl_documents_lister).",
          "requis": true
        }
      },
      "action": true
    }
  ]
}
