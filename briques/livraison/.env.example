# Jamais `API_KEYS` ici : la clé de cette brique est LIVRAISON_API_KEYS (propre).
DOKPLOY_URL=
DOKPLOY_API_KEY=
# Non utilisés en v1 (forgejo.py n'est pas branché) ; réservés à la suite.
FORGEJO_URL=
FORGEJO_TOKEN=
# Clé(s) acceptée(s) par la brique (liste séparée par des virgules). OBLIGATOIRE pour les
# actions : vide/absente ⇒ redemarrer/deployer/rollback répondent 403 (fail-closed) ;
# seules les lectures restent ouvertes.
LIVRAISON_API_KEYS=
# Clé que le CŒUR présente à la brique (X-API-Key) : = l'une des valeurs de LIVRAISON_API_KEYS,
# à poser dans l'environnement du Cœur. Piège : clé posée côté brique seule ⇒ 401 depuis
# l'assistant. Ne JAMAIS vider LIVRAISON_API_KEYS pour « réparer » : ça ferme les actions (403)
# et ouvre les lectures à tout le LAN.
LIVRAISON_KEY=
# Exécuteur de restauration (VM 100, S247) : URL et clé. À poser dans briques/livraison/.env
# (fichier LOCAL à la brique, chmod 0600), PAS dans le .env racine (partagé par ~45 briques). La clé est celle de EXECUTEUR_KEY dans
# /etc/executeur-restauration/env sur la VM 100. Jamais de secret S3 ici (il ne quitte pas la VM 100).
EXECUTEUR_URL=
EXECUTEUR_KEY=
# Inventaire des sauvegardes par application (défaut : $LIVRAISON_DATA/inventaire.json).
LIVRAISON_INVENTAIRE=
# Entrée de Traefik joignable depuis la brique (reset bleu/vert et retour arrière : contrôle de
# santé de l'instance inactive via l'hôte de TEST, AVANT la bascule ; aucun contrôle après).
# OBLIGATOIRE pour reset/retour arrière : absente ⇒ 503. Ex : http://192.168.1.165:80
LIVRAISON_TRAEFIK_URL=
# Chiffrement au repos des paquets de données utilisateur (S248). base64 de 32 octets aléatoires :
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# À poser dans briques/livraison/.env (local, 0600), PAS dans le .env racine. Absente => 503.
# Changer cette clé rend illisibles les paquets déjà stockés.
LIVRAISON_CHIFFREMENT_CLE=
# Clés de support des apps à contrat (même valeur que celle posée côté app), une variable par app,
# nom = <APP>_SUPPORT_KEY (voir contrats.json).
STUDIO_SUPPORT_KEY=
