{
  "nom": "studio",
  "famille": "media",
  "version": "0.7.0",
  "description": "Studio d'audio-séries co-créées : bible (Showrunner) → épisodes (Scénariste/Script Doctor) → audio (voix figées par personnage, multilingue avec traduction au rendu) → livre (Série/Cycle/Tome/Chapitre) → arbre des choix interactif. Équipe créative de 6 agents INTERNALISÉE (prompts figés, plus de couplage au monde Oria). Compose les briques personnages (5900), images (5950), video (5970) et voix (5810) sans les absorber : portraits + couvertures (images), bande-annonce d'épisode + animation de portrait (video). Persistance JSON propre. Extrait du backend Oria en brique autonome (S51).",
  "role": "studio",
  "couche": "backend",
  "statut": "a_tester",
  "chemin_source": "~/Desktop/Workplace/briques/studio",
  "port": 6060,
  "url_sante": "http://host.docker.internal:6060/sante",
  "depends_on": [],
  "offre": [
    "creer_serie",
    "cocreer_bible",
    "ecrire_chapitre",
    "episode_express",
    "rendre_audio_multilingue",
    "structure_livre",
    "exporter_livre",
    "arbre_des_choix",
    "distribution_casting_stable",
    "importer_personnages_holistiques",
    "renommer_personnage_de_serie",
    "journal_continuite",
    "agents_internalises",
    "compose_personnages_images_video_voix",
    "teaser_episode_video",
    "animer_portrait_video",
    "front_studio"
  ],
  "besoin": [],
  "taches": [],
  "capacites": [
    {
      "nom": "studio_series_lister",
      "description": "Liste les séries audio du Studio (titre, langue, nb de chapitres/personnages/tomes). Lecture seule.",
      "methode": "GET",
      "chemin": "/series",
      "params": {},
      "action": false
    },
    {
      "nom": "studio_serie_lire",
      "description": "Détail d'une série du Studio : bible (univers, personnages, intrigue…), épisodes produits, réglages. Récupère d'abord l'id via studio_series_lister. Lecture seule.",
      "methode": "GET",
      "chemin": "/series/{serie_id}",
      "params": {
        "serie_id": {
          "type": "string",
          "description": "Id de la série (via studio_series_lister).",
          "requis": true
        }
      },
      "action": false
    },
    {
      "nom": "studio_personnages_lister",
      "description": "Liste la distribution (personnages + voix figées) d'une série du Studio. Récupère l'id via studio_series_lister. Lecture seule.",
      "methode": "GET",
      "chemin": "/series/{serie_id}/personnages",
      "params": {
        "serie_id": {
          "type": "string",
          "description": "Id de la série (via studio_series_lister).",
          "requis": true
        }
      },
      "action": false
    },
    {
      "nom": "studio_voix_lister",
      "description": "Liste les voix disponibles pour une langue (catalogue du serveur de voix). Lecture seule.",
      "methode": "GET",
      "chemin": "/voix",
      "params": {
        "langue": {
          "type": "string",
          "description": "Code langue (fr, en, es…). Défaut fr."
        }
      },
      "action": false
    },
    {
      "nom": "studio_bible_proposer",
      "description": "Co-création de la bible : un agent créatif PROPOSE des options pour une dimension (genre, univers, personnages, intrigue, choix) — ne fige RIEN. Lecture seule (génératif mais non destructif).",
      "methode": "POST",
      "chemin": "/series/{serie_id}/proposer",
      "params": {
        "serie_id": {
          "type": "string",
          "description": "Id de la série (via studio_series_lister).",
          "requis": true
        },
        "dimension": {
          "type": "string",
          "enum": [
            "genre",
            "univers",
            "personnages",
            "intrigue",
            "choix"
          ],
          "description": "Dimension de la bible à explorer.",
          "requis": true
        },
        "mon_idee": {
          "type": "string",
          "description": "Piste/contrainte de l'utilisateur à intégrer (optionnel)."
        }
      },
      "action": false
    },
    {
      "nom": "studio_distribution_proposer",
      "description": "Le Directeur de Casting PROPOSE une distribution cohérente avec la bible — ne stocke RIEN. Lecture seule (génératif non destructif).",
      "methode": "POST",
      "chemin": "/series/{serie_id}/personnages/proposer",
      "params": {
        "serie_id": {
          "type": "string",
          "description": "Id de la série (via studio_series_lister).",
          "requis": true
        },
        "combien": {
          "type": "integer",
          "description": "Nombre de rôles à proposer (2 à 8, défaut 4)."
        },
        "mon_idee": {
          "type": "string",
          "description": "Piste à intégrer (optionnel)."
        }
      },
      "action": false
    },
    {
      "nom": "studio_serie_creer",
      "description": "Crée une nouvelle série audio dans le Studio. ACTION.",
      "methode": "POST",
      "chemin": "/series",
      "params": {
        "titre": {
          "type": "string",
          "description": "Titre de la série.",
          "requis": true
        },
        "idee": {
          "type": "string",
          "description": "Idée / genre de départ (optionnel)."
        },
        "langue": {
          "type": "string",
          "description": "Langue de travail (ex. fr, en, es). Défaut fr."
        },
        "cible": {
          "type": "string",
          "description": "Public visé (optionnel)."
        }
      },
      "action": true
    },
    {
      "nom": "studio_episode_produire",
      "description": "Produit l'épisode SUIVANT d'une série (Scénariste + Script Doctor), à partir de la bible existante. Récupère l'id via studio_series_lister. ACTION.",
      "methode": "POST",
      "chemin": "/series/{serie_id}/episode",
      "params": {
        "serie_id": {
          "type": "string",
          "description": "Id de la série (via studio_series_lister).",
          "requis": true
        }
      },
      "action": true
    },
    {
      "nom": "studio_express",
      "description": "Mode express : le Showrunner complète lui-même les pièces manquantes de la bible puis produit un épisode — de l'idée à l'épisode en un coup. ACTION.",
      "methode": "POST",
      "chemin": "/series/{serie_id}/express",
      "params": {
        "serie_id": {
          "type": "string",
          "description": "Id de la série (via studio_series_lister).",
          "requis": true
        },
        "idee": {
          "type": "string",
          "description": "Idée/orientation pour l'épisode (optionnel)."
        }
      },
      "action": true
    },
    {
      "nom": "studio_bible_decider",
      "description": "Fige (retient) le contenu d'une dimension de la bible. Utilise d'abord studio_bible_proposer pour explorer. ACTION.",
      "methode": "POST",
      "chemin": "/series/{serie_id}/decider",
      "params": {
        "serie_id": {
          "type": "string",
          "description": "Id de la série (via studio_series_lister).",
          "requis": true
        },
        "dimension": {
          "type": "string",
          "enum": [
            "genre",
            "univers",
            "personnages",
            "intrigue",
            "choix"
          ],
          "requis": true
        },
        "choix": {
          "type": "string",
          "description": "Le contenu retenu pour cette dimension.",
          "requis": true
        }
      },
      "action": true
    },
    {
      "nom": "studio_perso_creer",
      "description": "Ajoute un personnage à la distribution d'une série. ACTION.",
      "methode": "POST",
      "chemin": "/series/{serie_id}/personnages",
      "params": {
        "serie_id": {
          "type": "string",
          "description": "Id de la série (via studio_series_lister).",
          "requis": true
        },
        "nom": {
          "type": "string",
          "description": "Nom du personnage.",
          "requis": true
        },
        "role": {
          "type": "string",
          "description": "Rôle (protagoniste, antagoniste, secondaire…) (optionnel)."
        },
        "description": {
          "type": "string",
          "description": "Description du personnage (optionnel)."
        }
      },
      "action": true
    },
    {
      "nom": "studio_audio_produire",
      "description": "Produit l'audio d'un épisode déjà écrit (voix figées par personnage). Sans numéro, prend le dernier épisode. ACTION.",
      "methode": "POST",
      "chemin": "/series/{serie_id}/audio",
      "params": {
        "serie_id": {
          "type": "string",
          "description": "Id de la série (via studio_series_lister).",
          "requis": true
        },
        "n": {
          "type": "integer",
          "description": "Numéro d'épisode à sonoriser (optionnel : défaut = le dernier)."
        }
      },
      "action": true
    },
    {
      "nom": "studio_serie_supprimer",
      "description": "Supprime une série audio et tout son contenu (épisodes, personnages, bible). ACTION irréversible. Récupère d'abord l'id via studio_series_lister.",
      "methode": "DELETE",
      "chemin": "/series/{serie_id}",
      "params": {
        "serie_id": {
          "type": "string",
          "description": "Identifiant de la série.",
          "requis": true
        }
      },
      "action": true
    },
    {
      "nom": "studio_serie_langue_changer",
      "description": "Change la langue de production d'une série (voix, scripts). ACTION.",
      "methode": "POST",
      "chemin": "/series/{serie_id}/langue",
      "params": {
        "serie_id": {
          "type": "string",
          "description": "Identifiant de la série.",
          "requis": true
        },
        "langue": {
          "type": "string",
          "description": "Code langue ISO (ex: 'fr', 'en', 'es').",
          "requis": true
        }
      },
      "action": true
    },
    {
      "nom": "studio_personnage_portrait",
      "description": "Génère le portrait visuel d'un personnage d'une série (image IA). Retourne l'URL du portrait.",
      "methode": "POST",
      "chemin": "/series/{serie_id}/personnages/{pid}/portrait",
      "params": {
        "serie_id": {
          "type": "string",
          "description": "Identifiant de la série.",
          "requis": true
        },
        "pid": {
          "type": "string",
          "description": "Identifiant du personnage dans la série.",
          "requis": true
        }
      },
      "action": true
    },
    {
      "nom": "studio_personnage_animer",
      "description": "Anime le portrait d'un personnage de série (image → courte vidéo). Utilise la brique vidéo en coulisse.",
      "methode": "POST",
      "chemin": "/series/{serie_id}/personnages/{pid}/animer",
      "params": {
        "serie_id": {
          "type": "string",
          "description": "Identifiant de la série.",
          "requis": true
        },
        "pid": {
          "type": "string",
          "description": "Identifiant du personnage.",
          "requis": true
        }
      },
      "action": true
    },
    {
      "nom": "personnage_importer_serie",
      "description": "Importe un personnage DÉJÀ ENREGISTRÉ dans l'atelier holistique vers une série du Studio. Récupère fiche_id via personnages_fiches_lister et serie_id via studio_series_lister. ACTION.",
      "methode": "POST",
      "chemin": "/series/{serie_id}/personnages/importer-fiche",
      "params": {
        "serie_id": {
          "type": "string",
          "description": "Id de la série cible (via studio_series_lister).",
          "requis": true
        },
        "fiche_id": {
          "type": "string",
          "description": "Id de la fiche holistique (via personnages_fiches_lister).",
          "requis": true
        },
        "nom": {
          "type": "string",
          "description": "Nom de scène dans la série (optionnel : défaut = nom de la fiche)."
        }
      },
      "action": true
    },
    {
      "nom": "studio_series_reordonner",
      "description": "Réordonne les séries du Studio selon la suite d'identifiants fournie (la 1re devient la première affichée). ACTION.",
      "methode": "POST",
      "chemin": "/series/reordonner",
      "params": {
        "ids": {
          "type": "array",
          "description": "Nouvelle suite ordonnée des identifiants de séries.",
          "requis": true
        }
      },
      "action": true
    },
    {
      "nom": "studio_cycle_creer",
      "description": "Crée un cycle (regroupe des tomes) dans une série. Récupère serie_id via studio_series_lister. ACTION.",
      "methode": "POST",
      "chemin": "/series/{serie_id}/cycles",
      "params": {
        "serie_id": {
          "type": "string",
          "description": "Id de la série (via studio_series_lister).",
          "requis": true
        },
        "titre": {
          "type": "string",
          "description": "Titre du cycle (optionnel : défaut « Cycle N »)."
        },
        "resume": {
          "type": "string",
          "description": "Résumé du cycle (optionnel)."
        }
      },
      "action": true
    },
    {
      "nom": "studio_cycle_renommer",
      "description": "Renomme ou réécrit le résumé d'un cycle. Récupère les ids via studio_serie_lire. ACTION.",
      "methode": "PATCH",
      "chemin": "/series/{serie_id}/cycles/{cycle_id}",
      "params": {
        "serie_id": {
          "type": "string",
          "description": "Id de la série.",
          "requis": true
        },
        "cycle_id": {
          "type": "string",
          "description": "Id du cycle (via studio_serie_lire).",
          "requis": true
        },
        "titre": {
          "type": "string",
          "description": "Nouveau titre (optionnel)."
        },
        "resume": {
          "type": "string",
          "description": "Nouveau résumé (optionnel)."
        }
      },
      "action": true
    },
    {
      "nom": "studio_cycle_supprimer",
      "description": "Supprime un cycle VIDE. Refuse (409) si c'est le dernier cycle ou s'il contient des chapitres. Récupère cycle_id via studio_serie_lire. ACTION irréversible.",
      "methode": "DELETE",
      "chemin": "/series/{serie_id}/cycles/{cycle_id}",
      "params": {
        "serie_id": {
          "type": "string",
          "description": "Id de la série.",
          "requis": true
        },
        "cycle_id": {
          "type": "string",
          "description": "Id du cycle à supprimer (via studio_serie_lire).",
          "requis": true
        }
      },
      "action": true
    },
    {
      "nom": "studio_tome_creer",
      "description": "Crée un tome dans un cycle et le rend « actif » (les prochains chapitres s'y rangent). Récupère cycle_id via studio_serie_lire. ACTION.",
      "methode": "POST",
      "chemin": "/series/{serie_id}/cycles/{cycle_id}/tomes",
      "params": {
        "serie_id": {
          "type": "string",
          "description": "Id de la série.",
          "requis": true
        },
        "cycle_id": {
          "type": "string",
          "description": "Id du cycle parent (via studio_serie_lire).",
          "requis": true
        },
        "titre": {
          "type": "string",
          "description": "Titre du tome (optionnel : défaut « Tome N »)."
        },
        "resume": {
          "type": "string",
          "description": "Résumé du tome (optionnel)."
        }
      },
      "action": true
    },
    {
      "nom": "studio_tome_renommer",
      "description": "Renomme un tome, réécrit son résumé, ou change son statut (en_cours / termine). Récupère tome_id via studio_serie_lire. ACTION.",
      "methode": "PATCH",
      "chemin": "/series/{serie_id}/tomes/{tome_id}",
      "params": {
        "serie_id": {
          "type": "string",
          "description": "Id de la série.",
          "requis": true
        },
        "tome_id": {
          "type": "string",
          "description": "Id du tome (via studio_serie_lire).",
          "requis": true
        },
        "titre": {
          "type": "string",
          "description": "Nouveau titre (optionnel)."
        },
        "resume": {
          "type": "string",
          "description": "Nouveau résumé (optionnel)."
        },
        "statut": {
          "type": "string",
          "description": "Nouveau statut : en_cours ou termine (optionnel)."
        }
      },
      "action": true
    },
    {
      "nom": "studio_tome_supprimer",
      "description": "Supprime un tome VIDE. Refuse (409) si c'est le dernier tome ou s'il contient des chapitres. Récupère tome_id via studio_serie_lire. ACTION irréversible.",
      "methode": "DELETE",
      "chemin": "/series/{serie_id}/tomes/{tome_id}",
      "params": {
        "serie_id": {
          "type": "string",
          "description": "Id de la série.",
          "requis": true
        },
        "tome_id": {
          "type": "string",
          "description": "Id du tome à supprimer (via studio_serie_lire).",
          "requis": true
        }
      },
      "action": true
    },
    {
      "nom": "studio_tome_actif_definir",
      "description": "Définit le tome ACTIF d'une série (celui où se rangent les prochains chapitres écrits). Récupère tome_id via studio_serie_lire. ACTION.",
      "methode": "POST",
      "chemin": "/series/{serie_id}/tome-actif",
      "params": {
        "serie_id": {
          "type": "string",
          "description": "Id de la série.",
          "requis": true
        },
        "tome_id": {
          "type": "string",
          "description": "Id du tome à activer (via studio_serie_lire).",
          "requis": true
        }
      },
      "action": true
    },
    {
      "nom": "studio_tome_bilan",
      "description": "Fait le BILAN d'un tome : arc prévu vs chapitres réellement écrits, fils narratifs non résolus, verdict « fini normalement ? ». Analyse, ne modifie rien. Récupère tome_id via studio_serie_lire.",
      "methode": "POST",
      "chemin": "/series/{serie_id}/tomes/{tome_id}/bilan",
      "params": {
        "serie_id": {
          "type": "string",
          "description": "Id de la série.",
          "requis": true
        },
        "tome_id": {
          "type": "string",
          "description": "Id du tome à analyser (via studio_serie_lire).",
          "requis": true
        }
      },
      "action": false
    },
    {
      "nom": "studio_episode_couverture",
      "description": "Génère la COUVERTURE illustrée d'un chapitre (compose la brique images). Repli honnête (placeholder annoncé) si la brique images est injoignable. ACTION.",
