# Variables compose de la brique Agenda — copier en .env et remplir (gitignoré).
# Lues par docker compose pour la substitution ${...} du docker-compose.yml.

# Coffre de chiffrement des tokens OAuth (AES-GCM). Générer une chaîne aléatoire :
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AGENDA_VAULT_SECRET=

# Pont Google Agenda (S27) — projet Google Cloud, OAuth client "Application Web",
# scope https://www.googleapis.com/auth/calendar.readonly. Vides ⇒ pont désactivé (503).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Doit matcher l'URI de redirection enregistrée côté Google Cloud, à l'octet près.
# Local : http://localhost:8400/google/callback ; prod : https://agenda.<domaine>/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8400/google/callback
