# Usage standalone uniquement (docker compose -f gateway/docker-compose.yml).
# Via Makefile racine : cp .env.example .env && make seed-envs && make start-gateway

LITELLM_MASTER_KEY=sk-master-change-this
OPENROUTER_API_KEY=sk-or-...

# Ollama (local ou NetBird) — ex: http://100.x.x.x:11434 ou http://192.168.1.x:11434
# Laisser vide pour désactiver les modèles ollama/*
OLLAMA_URL=

# OpenCode Go — abonnement modèles (https://opencode.ai/go). Clé depuis la console
# Zen. Câble les modèles go/* via l'endpoint /zen/go/v1. Laisser vide pour désactiver.
OPENCODE_ZEN_API_KEY=

# ── Fournisseurs DIRECTS (alternatives à OpenRouter) ─────────────────────────
# Chacun active ses modèles `…-direct/*` (ou `groq/*`, `mistral/*`, `custom/llm`).
# Laisser vide = fournisseur désactivé. Pour basculer l'assistant dessus, poser la
# clé puis régler GATEWAY_MODEL (ex. anthropic-direct/claude-sonnet-4-6).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=

# Endpoint OpenAI-compatible quelconque (Together, Fireworks, Perplexity, proxy…)
# → active le modèle `custom/llm`. Les 3 doivent être posées ensemble.
# CUSTOM_LLM_MODEL doit rester NON-VIDE (provider/modèle valide) ; le placeholder
# ci-dessous est inerte tant que custom/llm n'est pas appelé. Ex. de vraie valeur :
#   CUSTOM_LLM_MODEL=openai/meta-llama/Llama-3.3-70B-Instruct-Turbo
CUSTOM_LLM_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=openai/not-configured

# IA locale générique (modèle `local/llm`) — tout serveur OpenAI-compatible :
#   LM Studio  → http://host.docker.internal:1234/v1
#   llama.cpp  → http://host.docker.internal:8080/v1
# Laisser vide pour désactiver local/llm. La clé est factice (acceptée par ces serveurs).
LOCAL_OPENAI_URL=
LOCAL_API_KEY=sk-local
