# Usage standalone uniquement (docker compose -f forge/docker-compose.standalone.yml).
# Via Makefile racine : cp .env.example .env && make seed-envs && make start-forge

# ── Gateway LiteLLM — point d'entrée unique (recommandé) ────
# Toutes les requêtes LLM passent par la gateway : 1 seule clé OPENROUTER_API_KEY
# suffit pour accéder à l'ensemble des providers cloud.
# Lance la gateway : cd gateway && make start
GATEWAY_BASE_URL=http://localhost:4000
GATEWAY_API_KEY=sk-forge

# ── Default provider ─────────────────────────────────────────
# gateway = point d'entrée unique via LiteLLM (recommandé)
# ollama  = LLM local direct (sans gateway)
DEFAULT_LLM_PROVIDER=gateway
DEFAULT_LLM_MODEL=openai/gpt-4o

# ── Clés providers (bypass gateway — optionnel) ──────────────
# Nécessaires uniquement si DEFAULT_LLM_PROVIDER != gateway
# ou si un preset Forge est configuré pour appeler un provider directement.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Pont Ollama — pour accéder au LLM local depuis téléphone / conteneur Docker
# Lance infra/ollama-bridge/ puis pointe OLLAMA_BASE_URL vers le bridge
# Exemple réseau local : OLLAMA_BASE_URL=http://192.168.1.100:11436
# Exemple Docker       : OLLAMA_BASE_URL=http://host.docker.internal:11436
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# ── Database ────────────────────────────────────────────────
# Identifiants PostgreSQL utilisés par docker-compose.yml (POSTGRES_USER:-forge etc.)
POSTGRES_USER=forge
POSTGRES_PASSWORD=forge
POSTGRES_DB=forge
DATABASE_URL=postgresql://forge:forge@localhost:5432/forge

# ── Qdrant ──────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Keycloak ────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_this_in_production
KEYCLOAK_REALM=forge

# ── NetBird ─────────────────────────────────────────────────
NETBIRD_API_URL=https://api.netbird.io
NETBIRD_TOKEN=nbp_your_personal_access_token
# 32-byte base64 key: openssl rand -base64 32
NETBIRD_DATASTORE_ENCRYPTION_KEY=change_this_base64_32_byte_key
# IP NetBird du Mac dev (utilisée par netbird-management pour l'allow-list)
# MACBOOK_NETBIRD_IP=100.x.x.x

# ── Domaine prod ────────────────────────────────────────────
# Utilisé par Traefik (forge.${DOMAIN}, oria.${DOMAIN}, …) et NetBird dashboard
# DOMAIN=example.com

# ── Security ────────────────────────────────────────────────
# 32-char random key: openssl rand -base64 32
ENCRYPTION_KEY=change_this_32_char_random_key!!

# ── Voice / Search ──────────────────────────────────────────
BRAVE_SEARCH_API_KEY=your_brave_key
DEEPGRAM_API_KEY=your_deepgram_key
ELEVENLABS_API_KEY=your_elevenlabs_key

# ── Services ────────────────────────────────────────────────
CORE_PORT=3001
FRONTEND_URL=http://localhost:3000
ML_MODULE_URL=http://localhost:8001
VITE_API_URL=http://localhost:8600
VITE_WS_URL=ws://localhost:8600
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=forge
VITE_KEYCLOAK_CLIENT_ID=forge-app
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=forge

# ── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=Forge <your_email@gmail.com>

# ── Brique Mémoire Workplace (opt-in) ────────────────────────
# Enrichit le RAG Forge avec les souvenirs de la mémoire Workplace, et y retient
# les documents ingérés. Contrat simple sans token : /rappeler, /retenir (la
# brique encapsule espaces + JWT + projet Memory). Remplace MemPalace.
# Vide = RAG Qdrant seul. Démarrée par « Lancer Workplace.command » (port 5600).
MEMOIRE_URL=http://host.docker.internal:5600
# Espace mémoire ciblé. Vide = espace solution « Workplace ». Ex. : Perso
MEMOIRE_ESPACE=

# ── Calendar service (S2S) ───────────────────────────────────
CALENDAR_URL=http://calendar:8400
CALENDAR_SERVICE_TOKEN=

# ── Dozzle (log viewer LAN-only) ────────────────────────────
VITE_DOZZLE_URL=http://localhost:9998

# ── Web Push (VAPID) ────────────────────────────────────────
# Générer : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@localhost
