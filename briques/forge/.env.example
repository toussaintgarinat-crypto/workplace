# Brique forge — gabarit des variables d'INTERPOLATION du compose (briques/forge/.env).
# Copier en .env et remplir. Le compose lit AUSSI le .env RACINE (../../.env) via env_file
# pour les clés maîtresses partagées (GATEWAY_API_KEY, FORGE_SERVICE_SECRET, VAULT_SECRET…) :
# ces clés-là vivent dans le .env racine, PAS ici.
#
# ⚠️ SECRETS — ne JAMAIS committer le .env réel (gitignoré).

# Postgres de Forge (forge-db). Doit correspondre à la valeur attendue par forge-core.
FORGE_DB_PASSWORD=change-me-forge-db

# Clé de chiffrement au repos de Forge (secrets connecteurs/CRM). 32+ octets aléatoires.
FORGE_ENCRYPTION_KEY=change-me-32-bytes-random

# SMTP sortant (relances/factures Forge). Laisser vide pour désactiver l'envoi réel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=
SMTP_SECURE=false
SMTP_STARTTLS=true

# Secret de signature des webhooks Stripe (paiements Forge). Vide = webhooks non vérifiés.
STRIPE_WEBHOOK_SECRET=
