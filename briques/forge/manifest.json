{
  "nom": "forge",
  "famille": "ia",
  "version": "1.0.0",
  "description": "Agents IA + RAG — moteur d'automatisation et base vectorielle",
  "role": "agents",
  "couche": "backend",
  "statut": "actif",
  "chemin_source": "briques/forge/forge",
  "port": 5700,
  "url_sante": "http://host.docker.internal:5700/sante",
  "url_ui": "http://localhost:3000",
  "vue_dashboard": "forge",
  "depends_on": [
    "gateway",
    "memoire",
    "geo",
    "audit",
    "ingestion"
  ],
  "offre": [
    "agents_ia",
    "rag",
    "vectorisation"
  ],
  "besoin": [
    "rappeler",
    "retenir"
  ],
  "taches": [
    {
      "nom": "relances-impayes",
      "description": "Relances J+7/15/30 des factures impayées (anti-doublon facture×niveau, géré par la brique)",
      "methode": "POST",
      "chemin": "/relances/executer",
      "cadence_heures": 24,
      "idempotent": true
    }
  ],
  "capacites": [
    {
      "nom": "forge_rag_chercher",
      "description": "Cherche dans les documents ingérés dans le RAG de Forge (recherche sémantique) et renvoie les passages pertinents. À utiliser pour « que dit le doc sur X ? » ou « cherche X dans Forge ». Lecture seule.",
      "methode": "GET",
      "chemin": "/rag/chercher",
      "params": {
        "q": {
          "type": "string",
          "description": "La question ou les termes à rechercher.",
          "requis": true
        }
      },
      "action": false
    },
    {
      "nom": "forge_factures_lister",
      "description": "Liste les devis et factures de Forge avec le chiffre d'affaires (encaissé, en attente). Pour les impayés, utilise statut='envoyée'. Lecture seule.",
      "methode": "GET",
      "chemin": "/facturation",
      "params": {
        "type": {
          "type": "string",
          "enum": [
            "facture",
            "devis"
          ],
          "description": "Filtre par type (optionnel)."
        },
        "statut": {
          "type": "string",
          "enum": [
            "brouillon",
            "envoyée",
            "payée",
            "annulée"
          ],
          "description": "Filtre par statut (optionnel)."
        }
      },
      "action": false
    },
    {
      "nom": "forge_crm_lister",
      "description": "Liste les prospects/clients du CRM de Forge avec le pipeline commercial. Filtre 'statut' optionnel. Lecture seule.",
      "methode": "GET",
      "chemin": "/crm",
      "params": {
        "statut": {
          "type": "string",
          "description": "Filtre par statut (ex. 'prospect', 'qualifié', 'gagné', 'perdu') (optionnel)."
        }
      },
      "action": false
    },
    {
      "nom": "forge_paiement_etat",
      "description": "État du paiement en ligne Stripe : encaissement réel ou simulé, abonnement courant, historique. Lecture seule.",
      "methode": "GET",
      "chemin": "/paiement/etat",
      "params": {},
      "action": false
    },
    {
      "nom": "forge_relances_apercu",
      "description": "Aperçu des relances de factures impayées qui seraient envoyées (J+7/15/30). N'envoie RIEN. Lecture seule.",
      "methode": "GET",
      "chemin": "/relances/apercu",
      "params": {},
      "action": false
    },
    {
      "nom": "forge_rag_ingerer",
      "description": "Ingère un document dans la base RAG de Forge (vectorisation) pour pouvoir l'interroger ensuite. ACTION.",
      "methode": "POST",
      "chemin": "/rag/ingerer",
      "params": {
        "nom": {
          "type": "string",
          "description": "Nom/titre du document.",
          "requis": true
        },
        "contenu": {
          "type": "string",
          "description": "Le texte du document à ingérer.",
          "requis": true
        }
      },
      "action": true
    },
    {
      "nom": "forge_lancer_agent",
      "description": "Lance un agent IA de Forge sur une tâche (il raisonne et peut utiliser des outils, via la Gateway). ACTION.",
      "methode": "POST",
      "chemin": "/agent/lancer",
      "params": {
        "objectif": {
          "type": "string",
          "description": "Ce que l'agent doit accomplir.",
          "requis": true
        },
        "contexte": {
          "type": "string",
          "description": "Contexte utile (optionnel)."
        }
      },
      "action": true
    },
    {
      "nom": "forge_facture_creer",
      "description": "Crée un devis ou une facture dans Forge (numérotation et calcul HT/TVA/TTC automatiques). ACTION.",
      "methode": "POST",
      "chemin": "/facturation",
      "params": {
        "client": {
          "type": "string",
          "description": "Nom du client.",
          "requis": true
        },
        "lignes": {
          "type": "array",
          "description": "Lignes du document (description + prix_unitaire requis par ligne).",
          "requis": true
        },
        "type": {
          "type": "string",
          "enum": [
            "facture",
            "devis"
          ],
          "description": "Défaut : facture."
        },
        "email": {
          "type": "string",
          "description": "Email du client (optionnel)."
        },
        "tva_taux": {
          "type": "number",
          "description": "Taux TVA par défaut en %."
        },
        "notes": {
          "type": "string"
        },
        "echeance": {
          "type": "string",
          "description": "Date d'échéance ISO (optionnel)."
        }
      },
      "action": true
    },
    {
      "nom": "forge_facture_statut",
      "description": "Change le statut d'une facture/devis ('payée', 'envoyée', 'annulée'). Récupère l'id via forge_factures_lister. ACTION.",
      "methode": "POST",
      "chemin": "/facturation/{id}/statut",
      "params": {
        "id": {
          "type": "string",
          "description": "Id du document (via forge_factures_lister).",
          "requis": true
        },
        "statut": {
          "type": "string",
          "enum": [
            "brouillon",
            "envoyée",
            "payée",
            "annulée"
          ],
          "requis": true
        }
      },
      "action": true
    },
    {
      "nom": "forge_facture_transformer",
      "description": "Transforme un devis accepté en facture. Récupère l'id du devis via forge_factures_lister. ACTION.",
      "methode": "POST",
      "chemin": "/facturation/{id}/transformer",
      "params": {
        "id": {
          "type": "string",
          "description": "Id du devis à transformer.",
          "requis": true
        }
      },
      "action": true
    },
    {
      "nom": "forge_crm_creer",
      "description": "Ajoute un prospect/client dans le CRM de Forge. ACTION.",
      "methode": "POST",
      "chemin": "/crm",
      "params": {
        "nom": {
          "type": "string",
          "description": "Nom du contact.",
          "requis": true
        },
        "entreprise": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "telephone": {
          "type": "string"
        },
        "statut": {
          "type": "string",
          "description": "Étape du pipeline (défaut 'prospect')."
        },
        "valeur": {
          "type": "integer",
          "description": "Valeur estimée en euros."
        },
        "notes": {
          "type": "string"
        }
      },
      "action": true
    },
    {
      "nom": "forge_crm_importer_lot",
      "description": "Verse EN LOT une liste de prospects dans le CRM — typiquement le résultat de geo_prospecter_lot (démarchage). Dé-doublonne contre l'existant ET dans le lot (par email, sinon nom d'entreprise) : ré-exécutable sans doublons. statut par défaut « à contacter ». Sert « mets ces prospects dans mon CRM ». ACTION.",
      "methode": "POST",
      "chemin": "/crm/import-lot",
      "params": {
        "prospects": {
          "type": "array",
          "description": "Liste d'objets prospect. Deux formes : ENTREPRISE {nom|entreprise, email?, telephone?, site?, naf?, commune?, ref_externe?, notes?} (résultat de geo_prospecter_lot type entreprise), ou LOGEMENT {adresse, commune?, code_postal?, grade_dpe?, surface_m2?, periode_construction?, ref_externe?} (résultat de geo_prospecter_lot type logement — JAMAIS de nom de personne, un logement n'a pas de propriétaire identifiable). Passe directement le champ « prospects » renvoyé par geo_prospecter_lot.",
          "requis": true
        },
        "statut": {
          "type": "string",
          "description": "Étape de départ dans le pipeline (défaut « à contacter »)."
        }
      },
      "action": true
    },
    {
      "nom": "forge_crm_modifier",
      "description": "Met à jour un prospect (statut, valeur, coordonnées). Récupère l'id via forge_crm_lister. Ne passe que les champs à changer. ACTION.",
      "methode": "POST",
      "chemin": "/crm/{id}",
      "params": {
        "id": {
          "type": "string",
          "description": "Id du prospect (via forge_crm_lister).",
          "requis": true
        },
        "statut": {
          "type": "string"
        },
        "valeur": {
          "type": "integer"
        },
        "nom": {
          "type": "string"
        },
        "entreprise": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "telephone": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "action": true
    },
    {
      "nom": "forge_paiement_lien",
      "description": "Crée un lien de paiement Stripe pour un plan d'abonnement. Si Stripe est configuré le lien est réel, sinon simulé. ACTION.",
      "methode": "POST",
      "chemin": "/paiement/lien",
      "params": {
        "plan": {
          "type": "string",
          "enum": [
            "starter",
            "pro",
            "enterprise"
          ],
          "description": "Plan d'abonnement.",
          "requis": true
        }
      },
      "action": true
    },
    {
      "nom": "forge_relances_envoyer",
      "description": "Lance l'envoi des relances dues pour les factures impayées (J+7/15/30). Vérifie d'abord avec forge_relances_apercu. ACTION.",
      "methode": "POST",
      "chemin": "/relances/executer",
      "params": {},
      "action": true
    },
    {
      "nom": "forge_facture_envoyer",
      "description": "Envoie une facture au client par email et la passe au statut 'envoyée'. Récupère l'id via forge_factures_lister. ACTION.",
      "methode": "POST",
      "chemin": "/facturation/{id}/envoyer",
      "params": {
        "id": {
          "type": "string",
          "description": "Id de la facture.",
          "requis": true
        }
      },
      "action": true
    }
  ]
}
