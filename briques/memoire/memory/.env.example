DATABASE_URL=postgresql+asyncpg://memory:memory@localhost:5432/memory

# Mot de passe de la DB Postgres standalone (interpolé dans docker-compose.yml).
# Défaut = memory (valeur du volume existant). Pour durcir : mettre une vraie
# valeur ici + ALTER USER memory en place (le volume conserve ses données).
MEMORY_DB_PASSWORD=memory

# ─── LLM — Providers supportés ───────────────────────────────
#   openrouter → OpenRouter (cloud, req. API key)
#   openai     → OpenAI (cloud, req. API key)
#   ollama     → Ollama (local)
#   llamacpp   → llama.cpp serveur HTTP direct (local)
#
# 1) llama.cpp (recommandé — local, performant, gratuit)
#    Installation: https://github.com/ggml-org/llama.cpp
#    Lancement: llama-server -m models/llama-3.2-3b-instruct.gguf --port 8080
LLM_PROVIDER=llamacpp
LLM_BASE_URL=http://localhost:8080
LLM_API_KEY=not-needed
LLM_MODEL=llama-3.2-3b-instruct

# 2) OpenRouter (cloud)
# LLM_PROVIDER=openrouter
# LLM_API_KEY=sk-...
# LLM_MODEL=anthropic/claude-3.5-sonnet

# 3) Ollama (local)
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3.2

# ─── Embedding (vecteurs pgvector) ───────────────────────────
# llama.cpp : utiliser un modèle embedding GGUF
#   → Télécharger: https://huggingface.co/nomic-ai/nomic-embed-text-v1.5-GGUF
#   → Lancer avec: llama-server -m models/nomic-embed-text-v1.5.gguf --embedding --port 8080
# OpenAI : text-embedding-3-small / text-embedding-3-large
EMBEDDING_MODEL=nomic-embed-text-v1.5

JWT_SECRET=change-me-in-production

MCP_SERVER_PORT=8100
